[Unit]
Description=BTC Trading Bot Model Retrainer
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/btc-trading-bot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/btc-trading-bot/.env
ExecStart=/home/ubuntu/btc-trading-bot/.venv/bin/python3 retrain_worker.py
CPUQuota=50%
MemoryLimit=800M

[Install]
WantedBy=multi-user.target

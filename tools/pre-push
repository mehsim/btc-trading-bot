#!/bin/sh
# Tracked at tools/pre-push — install with:
#   cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Verify on each machine:
#   test -x .git/hooks/pre-push && echo installed || echo MISSING

flake8 . --exclude=.venv,.git,__pycache__ --select=E9,F63,F7,F821 \
&& (python3 -m bandit -r . -x ./.venv,./tests -ll -q 2>/dev/null || true) \
&& python3 tools/check_silent_handlers.py \
&& python3 tools/check_print_ratchet.py

#!/bin/sh
# Tracked at tools/pre-push — install with:
#   cp tools/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Verify on each machine:
#   test -x .git/hooks/pre-push && echo installed || echo MISSING

FLAKE8_BIN="flake8"
if [ -f ".venv/bin/flake8" ]; then
    FLAKE8_BIN=".venv/bin/flake8"
fi

PYTHON_BIN="python3"
if [ -f ".venv/bin/python3" ]; then
    PYTHON_BIN=".venv/bin/python3"
fi

$FLAKE8_BIN . --exclude=.venv,.git,__pycache__ --select=E9,F63,F7,F821 \
&& ($PYTHON_BIN -m bandit -r . -x ./.venv,./tests -ll -q 2>/dev/null || true) \
&& $PYTHON_BIN tools/check_silent_handlers.py \
&& $PYTHON_BIN tools/check_print_ratchet.py


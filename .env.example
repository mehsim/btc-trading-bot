# ==========================================
# SOCIAL SENTIMENT API KEYS & OPTIONS
# ==========================================

# 1. X (Twitter) API v2 Bearer Token
# (Requires a paid Basic developer subscription for searching recent tweets)
TWITTER_BEARER_TOKEN=""

# 2. CryptoPanic API Token
# (Free - generate a developer token instantly at https://cryptopanic.com/developers/api/)
CRYPTOPANIC_API_TOKEN=""

# ==========================================
# TIMING & API/PROXY HIT INTERVALS (Optional)
# ==========================================
# Polling window in minutes after the hour boundary to verify completed candles (default: 5)
CANDLE_CHECK_WINDOW_MINS=5
# Frequency (in seconds) to check for completed candles during the polling window (default: 20)
CANDLE_CHECK_INTERVAL_SECS=20
# Background wallet balance synchronization interval (in seconds) (default: 120)
BALANCE_UPDATE_INTERVAL_SECS=120
# Position sync frequency when trades are active vs when idle (in seconds) (defaults: 30 / 120)
POSITION_SYNC_INTERVAL_SECS=30
POSITION_SYNC_IDLE_INTERVAL_SECS=120

# ==========================================
# TELEGRAM MOBILE MONITORING ALERTS
# ==========================================
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
TELEGRAM_PROXY=""


